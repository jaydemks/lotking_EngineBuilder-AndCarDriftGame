":"Editor / Play-in-Editor only; standalone and exported gameplay never create these helpers."},{"name":"TpsWallFlipSettleDuration","type":"number","value":0.55,"min":0.05,"max":2,"step":0.01,"exposed":true,"binding":"abilities.wallFlip.settleDuration","label":"Wall Flip Walk-to-idle Duration","category":"Traversal"},{"name":"TpsWallFlipSettleSpeed","type":"number","value":0.42,"min":0.05,"max":1,"step":0.01,"exposed":true,"binding":"abilities.wallFlip.settleSpeedScale","label":"Wall Flip Walk-to-idle Speed Scale","category":"Traversal"},{"name":"FacingMode","type":"string","value":"heading","exposed":true,"binding":"movement.facingMode","label":"Facing Mode","category":"Movement","ui":"select","options":[{"value":"movement","label":"Face movement direction"},{"value":"heading","label":"Preserve character / aim heading"}],"description":"Heading-relative input should preserve heading. Camera-relative movement may rotate the body toward travel."},{"name":"TpsStartView","type":"string","value":"third","exposed":true,"binding":"firstPerson.view","label":"Start View","category":"Third Person / Camera","ui":"select","options":[{"value":"third","label":"Third person (over the shoulder)"},{"value":"first","label":"First person (eye)"}],"description":"Which view the Pawn spawns in. Camera Mode swaps them at runtime either way."},{"name":"TpsAllowViewToggle","type":"boolean","value":true,"exposed":true,"binding":"firstPerson.allowViewToggle","label":"Allow First / Third Toggle","category":"Third Person / Camera"},{"name":"TpsDistance","type":"number","value":3.3,"exposed":true,"binding":"firstPerson.thirdPerson.distance","label":"Camera Distance (m)","category":"Third Person / Camera","min":0.6,"max":14,"step":0.05},{"name":"TpsAutoDistance","type":"boolean","value":false,"exposed":true,"binding":"firstPerson.thirdPerson.autoDistance","label":"Automatic ADS / Sprint Distance","category":"Third Person / Camera","description":"Off keeps the authored or player-wheel distance fixed. On restores the cinematic ADS pull-in and sprint pull-back."},{"name":"TpsDistanceAds","type":"number","value":1.9,"exposed":true,"binding":"firstPerson.thirdPerson.distanceAds","label":"Camera Distance Aiming","category":"Third Person / Camera","min":0.4,"max":14,"step":0.05},{"name":"TpsDistanceSprint","type":"number","value":4.1,"exposed":true,"binding":"firstPerson.thirdPerson.distanceSprint","label":"Camera Distance Sprinting","category":"Third Person / Camera","min":0.4,"max":16,"step":0.05},{"name":"TpsHeight","type":"number","value":1.5,"exposed":true,"binding":"firstPerson.thirdPerson.height","label":"Pivot Height (m)","category":"Third Person / Camera","min":0.1,"max":4,"step":0.02},{"name":"TpsHeightAds","type":"number","value":1.58,"exposed":true,"binding":"firstPerson.thirdPerson.heightAds","label":"Pivot Height Aiming","category":"Third Person / Camera","min":0.1,"max":4,"step":0.02},{"name":"TpsShoulder","type":"number","value":0.62,"exposed":true,"binding":"firstPerson.thirdPerson.shoulder","label":"Shoulder Offset (m)","category":"Third Person / Camera","min":-3,"max":3,"step":0.02,"description":"Lateral offset that keeps the body out of the aiming line. Positive is the right shoulder."},{"name":"TpsShoulderAds","type":"number","value":0.48,"exposed":true,"binding":"firstPerson.thirdPerson.shoulderAds","label":"Shoulder Offset Aiming","category":"Third Person / Camera","min":-3,"max":3,"step":0.02},{"name":"TpsShoulderSprint","type":"number","value":0.2,"exposed":true,"binding":"firstPerson.thirdPerson.shoulderSprint","label":"Shoulder Offset Sprinting","category":"Third Person / Camera","min":-3,"max":3,"step":0.02},{"name":"TpsPivotForward","type":"number","value":0.18,"exposed":true,"binding":"firstPerson.thirdPerson.pivotForward","label":"Pivot Forward (m)","category":"Third Person / Camera","min":-2,"max":2,"step":0.02},{"name":"TpsFov","type":"number","value":68,"exposed":true,"binding":"firstPerson.thirdPerson.fov","label":"FOV","category":"Third Person / Camera","min":20,"max":130,"step":1},{"name":"TpsFovAds","type":"number","value":52,"exposed":true,"binding":"firstPerson.thirdPerson.fovAds","label":"FOV Aiming","category":"Third Person / Camera","min":20,"max":130,"step":1},{"name":"TpsFocusDistance","type":"number","value":9,"exposed":true,"binding":"firstPerson.thirdPerson.focusDistance","label":"Manual Focus Distance (m)","category":"Third Person / Camera","min":0.25,"max":200,"step":0.25},{"name":"TpsNear","type":"number","value":0.1,"exposed":true,"binding":"firstPerson.thirdPerson.near","label":"Near Clip (m)","category":"Third Person / Camera","min":0.02,"max":0.5,"step":0.01},{"name":"TpsFovSpeedGain","type":"number","value":0.9,"exposed":true,"binding":"firstPerson.thirdPerson.fovSpeedGain","label":"Dynamic FOV Gain","category":"Third Person / Camera","min":0,"max":6,"step":0.05,"description":"Degrees of extra field of view per m/s above walking pace. Zero disables the speed lens."},{"name":"TpsFovSpeedMax","type":"number","value":8,"exposed":true,"binding":"firstPerson.thirdPerson.fovSpeedMax","label":"Dynamic FOV Max","category":"Third Person / Camera","min":0,"max":30,"step":0.5},{"name":"TpsCollisionMode","type":"string","value":"fixed","exposed":true,"binding":"firstPerson.thirdPerson.collisionMode","label":"Wall Obstruction","category":"Third Person / Camera","ui":"select","options":[{"value":"fixed","label":"Collision-safe snap (default)"},{"value":"pull-in","label":"Pull camera in before walls"}],"description":"Fixed preserves framing while clear and snaps only when needed to keep the lens outside geometry. Pull-in adds spring easing."},{"name":"TpsCollisionRadius","type":"number","value":0.34,"exposed":true,"binding":"firstPerson.thirdPerson.collisionRadius","label":"Camera Probe Radius","category":"Third Person / Camera","min":0.05,"max":2,"step":0.01,"description":"Probe radius used only by Pull camera in and by first-person leaning."},{"name":"TpsMinimumBodyDistance","type":