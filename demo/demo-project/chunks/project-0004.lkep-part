r Character (Male)","collide":false,"graph":{"version":1,"name":"Template - Player Character (Normal)","scope":"element","enabled":true,"variables":[{"name":"PawnEnabled","type":"boolean","value":true,"exposed":true,"binding":"enabled","label":"Pawn Enabled","category":"Pawn"},{"name":"Hidden","type":"boolean","value":false,"exposed":true,"binding":"hidden","label":"Hidden","category":"Pawn"},{"name":"ControllerPlayerId","type":"number","value":1,"exposed":true,"binding":"playerId","label":"Controller Player ID","category":"Input","ui":"player-id"},{"name":"SpawnX","type":"number","value":0,"step":0.1,"exposed":true,"binding":"spawn.x","label":"Spawn X","category":"Pawn / Spawn"},{"name":"SpawnY","type":"number","value":0,"step":0.1,"exposed":true,"binding":"spawn.y","label":"Spawn Y","category":"Pawn / Spawn"},{"name":"SpawnZ","type":"number","value":8,"step":0.1,"exposed":true,"binding":"spawn.z","label":"Spawn Z","category":"Pawn / Spawn"},{"name":"SpawnHeading","type":"number","value":3.141592653589793,"step":0.01,"exposed":true,"binding":"spawn.heading","label":"Spawn Heading","category":"Pawn / Spawn"},{"name":"WalkSpeed","type":"number","value":1.8,"min":0.2,"max":8,"step":0.1,"exposed":true,"binding":"movement.walkSpeed","label":"Walk Speed (m/s)","category":"Movement"},{"name":"RunSpeed","type":"number","value":4.8,"min":0.5,"max":14,"step":0.1,"exposed":true,"binding":"movement.runSpeed","label":"Run Movement Speed (m/s)","category":"Movement","description":"Physical top speed when Run is pressed. Animation playback is authored separately in Motion Animation Set."},{"name":"SprintMultiplier","type":"number","value":1,"min":1,"max":2.5,"step":0.05,"exposed":true,"binding":"movement.sprintMultiplier","label":"Extra Sprint Multiplier","category":"Movement","description":"Optional multiplier over Run Movement Speed. Keep 1 for the authored speed to be the actual top speed."},{"name":"Acceleration","type":"number","value":13,"min":1,"max":80,"step":0.5,"exposed":true,"binding":"movement.acceleration","label":"Acceleration","category":"Movement"},{"name":"TurnRate","type":"number","value":10,"min":0.5,"max":40,"step":0.5,"exposed":true,"binding":"movement.turnRate","label":"Turn Rate (rad/s)","category":"Movement"},{"name":"JumpHeight","type":"number","value":1.05,"min":0,"max":5,"step":0.05,"exposed":true,"binding":"movement.jumpHeight","label":"Jump Height (m)","category":"Movement"},{"name":"StepHeight","type":"number","value":0.55,"min":0,"max":3,"step":0.02,"exposed":true,"binding":"movement.stepHeight","label":"Step Height (m)","category":"Movement"},{"name":"Gravity","type":"number","value":22,"min":1,"max":80,"step":0.5,"exposed":true,"binding":"movement.gravity","label":"Gravity (m/s²)","category":"Movement"},{"name":"AirControl","type":"number","value":0.32,"min":0,"max":1,"step":0.05,"exposed":true,"binding":"movement.airControl","label":"Air Control","category":"Movement"},{"name":"VehicleExitRollSpeed","type":"number","value":12,"min":0,"max":120,"step":1,"exposed":true,"binding":"entry.dismount.rollStartKmh","label":"Vehicle Exit Roll From (km/h)","category":"Vehicle Exit","description":"Below this speed the Character steps out normally. From here to the damage threshold it exits directly into the authored roll."},{"name":"VehicleExitDamageSpeed","type":"number","value":25,"min":1,"max":240,"step":1,"exposed":true,"binding":"entry.dismount.damageStartKmh","label":"Vehicle Exit Damage From (km/h)","category":"Vehicle Exit","description":"Road-vehicle exits above this speed take scalar impact damage and roll if survived."},{"name":"VehicleExitLethalSpeed","type":"number","value":80,"min":2,"max":400,"step":1,"exposed":true,"binding":"entry.dismount.lethalKmh","label":"Vehicle Exit Lethal From (km/h)","category":"Vehicle Exit","description":"At or above this speed a road-vehicle dismount is immediately lethal and enters death physics / ragdoll."},{"name":"VehicleExitDamageAtLethal","type":"number","value":100,"min":0,"max":10000,"step":5,"exposed":true,"binding":"entry.dismount.damageAtLethal","label":"Damage Near Lethal Speed","category":"Vehicle Exit"},{"name":"InputMode","type":"string","value":"heading","exposed":true,"binding":"movement.inputMode","label":"Input Mode","category":"Movement","ui":"select","options":[{"value":"camera","label":"Camera relative (recommended)"},{"value":"heading","label":"Character heading"}]},{"name":"Preset","type":"string","value":"normal","exposed":true,"binding":"preset","label":"Character Preset","category":"Character","ui":"select","options":[{"value":"normal","label":"Normal (balanced)"},{"value":"civil","label":"Civil (slower / grounded)"},{"value":"police","label":"Police (responsive / athletic)"}],"description":"Starting behavior profile. Applying it sets the baseline movement values; tune individual Movement fields afterward for a custom subtype."},{"name":"BlendResponsiveness","type":"number","value":9,"min":0.5,"max":30,"step":0.5,"exposed":true,"binding":"locomotion.responsiveness","label":"Motion Blend Responsiveness","category":"Movement / Motion Blend"},{"name":"BlendPrediction","type":"number","value":0.12,"min":0,"max":0.6,"step":0.01,"exposed":true,"binding":"locomotion.predictionTime","label":"Motion Blend Prediction (s)","category":"Movement / Motion Blend"},{"name":"StepPoseStrength","type":"number","value":1,"min":0,"max":2,"step":0.05,"exposed":true,"binding":"locomotion.stepPoseStrength","label":"Stair Pose Strength","category":"Movement / Motion Blend"},{"name":"CharacterImplementation","type":"string","value":"native","exposed":true,"binding":"implementation","label":"Locomotion Backend","category":"Character","ui":"select","options":[{"value":"native","label":"Engine character"},{"value":"sketchbook","label":"Sketchbook character"}]},{"name":"MaxHealth","type":"number","value":100,"min":1,"max":1000,"step":5,"exposed":true,"binding":"vitals.maxHealth","label":"Max Health","category":"Character / Vitals"},{"name":"MaxArmor","type":"number","value":0,"min":0,"max":1000,"step":5,"exposed":true,"binding":"vitals.maxArmor","label":"Max Armour","category":"Character / Vitals"},{"name":"RespawnMode","type":"string","value":"spawn","exposed":true,"binding":"vitals.respawnMode","label":"Respawn After Death","category":"Character / Vitals","ui":"select","options":[{"value":"none","label":"Never (default)"},{"value":"death","label":"At death position"},{"value":"spawn","label":"At original spawn"},{"value":"random","label":"Random playable position"}]},{"name":"RespawnDelay","type":"number","value":2.5,"min":0,"max":60,"step":0.1,"exposed":true,"binding":"vitals.respawnDelay","label":"Respawn Delay (s)","category":"Character / Vitals"},{"name":"RespawnRandomRadius","type":"number","value":35,"min":1,"max":10000,"step":1,"exposed":true,"binding":"vitals.respawnRandomRadius","label":"Random Spawn Radius (fallback)","category":"Character / Vitals"},{"name":"DeathPhysicsEnabled","type":"boolean","value":true,"exposed":true,"binding":"vitals.deathPhysics.enabled","label":"Physical Death / Ragdoll","category":"Character / Vitals"},{"name":"DeathPhysicsMode","type":"string","value":"auto","exposed":true,"binding":"vitals.deathPhysics.mode","label":"Death Physics Mode","category":"Character / Vitals","ui":"select","options":[{"value":"auto","label":"Auto — ragdoll or physical fallback"},{"value":"ragdoll","label":"Ragdoll"},{"value":"rigid","label":"Physical fallback"}]},{"name":"CameraMode","type":"string","value":"free","exposed":true,"binding":"camera.mode","label":"Camera Mode","category":"Camera","ui":"select","options":[{"value":"free","label":"Free"},{"value":"arcade","label":"Arcade follow"},{"value":"cinematic","label":"Cinematic"}]},{"name":"CameraView","type":"string","value":"third","exposed":true,"binding":"camera.view","label":"View","category":"Camera","ui":"select","options":[{"value":"third","label":"Third person"},{"value":"close","label":"Close third person"},{"value":"first","label":"First person (lite)"}]},{"name":"CameraDistance","type":"number","value":6.8,"min":0.2,"max":40,"step":0.1,"exposed":true,"binding":"camera.distance","label":"Distance","category":"Camera"},{"name":"CameraHeight","type":"number","value":2.35,"min":0.2,"max":20,"step":0.1,"exposed":true,"binding":"camera.height","label":"Height","category":"Camera"},{"name":"CameraLag","type":"number","value":7,"min":0.1,"max":30,"step":0.1,"exposed":true,"binding":"camera.lag","label":"Lag","category":"Camera"},{"name":"CameraFov","type":"number","value":62,"min":20,"max":130,"step":1,"exposed":true,"binding":"camera.fov","label":"FOV","category":"Camera"},{"name":"ShirtColor","type":"string","value":"#4f8fbf","exposed":true,"binding":"appearance.shirtColor","label":"Top Color","category":"Appearance","ui":"color"},{"name":"PantsColor","type":"string","value":"#263445","exposed":true,"binding":"appearance.shortsColor","label":"Pants Color","category":"Appearance","ui":"color"},{"name":"HairColor","type":"string","value":"#2b2118","exposed":true,"binding":"appearance.hairColor","label":"Hair Color","category":"Appearance","ui":"color"},{"name":"SkinColor","type":"string","value":"#d8a184","exposed":true,"binding":"appearance.skinColor","label":"Skin Color","category":"Appearance","ui":"color"},{"name":"AnimationLibrary","type":"string","value":"","exposed":true,"binding":"animationLibrary","ui":"model-asset","label":"Animation Library GLB (clips only)","category":"Animations","description":"Optional clips-only GLB. It must use the same skeleton/bone names as the character model (for example the same Mixamo rig). Locomotion clips should be in-place; do not enable root motion."},{"name":"BodyType","type":"string","value":"male","exposed":true,"binding":"bodyType","label":"Body","category":"Pawn","ui":"select","options":[{"value":"male","label":"Mannequin - Male"},{"value":"female","label":"Mannequin - Female"}],"description":"Which bundled mannequin this Pawn starts as. Both stand 1.8 m tall and share the same actions; each has its own walk, run, strafe and turn cycles. Replacing the Model field with your own rigged GLB or FBX overrides it."},{"name":"AnimIdle","type":"string","value":{"clip":"Idle","asset":{"id":"idle","key":"builtin:character/mannequin-male/idle.fbx","src":"models/characters/mannequin-male/idle.fbx","name":"Mannequin - Male Idle","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/mannequin-male/idle.fbx"}},"exposed":true,"binding":"animations.idle","label":"Idle Clip","category":"Animations","description":"Idle — looping, in-place, no root motion. Neutral standing pose with a stable first/last frame."},{"name":"AnimWalk","type":"string","value":{"clip":"Walking","asset":{"id":"walking","key":"builtin:character/mannequin-male/walking.fbx","src":"models/characters/mannequin-male/walking.fbx","name":"Mannequin - Male Walk","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/mannequin-male/walking.fbx"}},"exposed":true,"binding":"animations.walk","label":"Walk Clip","category":"Animations","description":"Walk — looping, in-place, no root motion. Forward walk cycle; the controller supplies world translation."},{"name":"AnimRun","type":"string","value":{"clip":"Running","asset":{"id":"running","key":"builtin:character/mannequin-male/running.fbx","src":"models/characters/mannequin-male/running.fbx","name":"Mannequin - Male Run","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/mannequin-male/running.fbx"}},"exposed":true,"binding":"animations.run","label":"Run Clip","category":"Animations","description":"Run — looping, in-place, no root motion. Forward run/jog cycle matched to Run Speed."},{"name":"AnimStrafeLeft","type":"string","value":{"clip":"Left Strafe","asset":{"id":"strafe-walk-left","key":"builtin:character/mannequin-male/strafe-walk-left.fbx","src":"models/characters/mannequin-male/strafe-walk-left.fbx","name":"Mannequin - Male Strafe Walk Left","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/mannequin-male/strafe-walk-left.fbx"}},"exposed":true,"binding":"animations.strafeLeft","label":"Strafe Left Clip","category":"Animations","description":"Strafe Left — looping, in-place, no root motion. Optional lateral cycle; Walk is used as fallback."},{"name":"AnimStrafeRight","type":"string","value":{"clip":"Right Strafe","asset":{"id":"strafe-walk-right","key":"builtin:character/mannequin-male/strafe-walk-right.fbx","src":"models/characters/mannequin-male/strafe-walk-right.fbx","name":"Mannequin - Male Strafe Walk Right","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/mannequin-male/strafe-walk-right.fbx"}},"exposed":true,"binding":"animations.strafeRight","label":"Strafe Right Clip","category":"Animations","description":"Strafe Right — looping, in-place, no root motion. Optional lateral cycle; Walk is used as fallback."},{"name":"AnimJump","type":"string","value":{"clip":"Jump","asset":{"id":"jump","key":"builtin:character/mannequin-male/jump.fbx","src":"models/characters/mannequin-male/jump.fbx","name":"Mannequin - Male Jump","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/mannequin-male/jump.fbx"}},"exposed":true,"binding":"animations.jump","label":"Jump Clip","category":"Animations","description":"Jump — one-shot, in-place, no root translation. Prefer a complete take-off/air/landing clip; gameplay height comes from Jump Height."},{"name":"AnimFall","type":"string","value":{"clip":"Falling Idle","asset":{"id":"falling-idle","key":"builtin:character/shared/falling-idle.fbx","src":"models/characters/shared/falling-idle.fbx","name":"Falling Idle","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/falling-idle.fbx"}},"exposed":true,"binding":"animations.fall","label":"Fall Clip","category":"Animations","description":"Fall — optional looping in-air pose, in-place and without root motion. Reserved for the expanded airborne state."},{"name":"AnimLand","type":"string","value":{"clip":"Landing","asset":{"id":"run-to-stop","key":"builtin:character/shared/run-to-stop.fbx","src":"models/characters/shared/run-to-stop.fbx","name":"Run To Stop","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/run-to-stop.fbx"}},"exposed":true,"binding":"animations.land","label":"Land Clip","category":"Animations","description":"Land — optional short one-shot, in-place and without root motion. Reserved for landing transitions."},{"name":"AnimLandMoving","type":"string","value":{"clip":"Falling To Landing","asset":{"id":"falling-to-landing","key":"builtin:character/shared/falling-to-landing.fbx","src":"models/characters/shared/falling-to-landing.fbx","name":"Falling To Landing","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/falling-to-landing.fbx"}},"exposed":true,"binding":"animations.landMoving","label":"Moving Land Clip","category":"Animations","description":"Moving Land — one-shot transition from the airborne pose directly back into a continuing walk/run. The controller supplies translation."},{"name":"AnimInteract","type":"string","value":"Interact","exposed":true,"binding":"animations.interact","label":"Interact Clip","category":"Animations","description":"Interact — optional one-shot in-place action (talk, inspect, press button), without root motion. It must return to the locomotion pose."},{"name":"AnimRoll","type":"string","value":{"clip":"Falling To Roll","asset":{"id":"falling-to-roll","key":"builtin:character/shared/falling-to-roll.fbx","src":"models/characters/shared/falling-to-roll.fbx","name":"Falling To Roll","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/falling-to-roll.fbx"}},"exposed":true,"binding":"animations.roll","label":"Roll Clip","category":"Animations","description":"Roll — one-shot. Played by the dodge double-tap, by a landing taken at speed, and by the fall-recovery. In-place; the controller carries the character."},{"name":"AnimSlide","type":"string","value":{"clip":"Running Slide","asset":{"id":"running-slide","key":"builtin:character/shared/running-slide.fbx","src":"models/characters/shared/running-slide.fbx","name":"Running Slide","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/running-slide.fbx"}},"exposed":true,"binding":"animations.slide","label":"Slide Clip","category":"Animations","description":"Slide — one-shot. Played when the dodge is used at running speed. In-place; the controller carries the slide."},{"name":"AnimVault","type":"string","value":{"clip":"Front Flip Running Vault","asset":{"id":"front-flip-vault","key":"builtin:character/shared/front-flip-vault.fbx","src":"models/characters/shared/front-flip-vault.fbx","name":"Front Flip Running Vault","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/front-flip-vault.fbx"}},"exposed":true,"binding":"animations.vault","label":"Vault Clip","category":"Animations","description":"Vault — one-shot. Played when the character crosses an obstacle between Vault Min and Max Height."},{"name":"AnimVaultBox","type":"string","value":{"clip":"Vault Over Box","asset":{"id":"vault-over-box","key":"builtin:character/shared/vault-over-box.fbx","src":"models/characters/shared/vault-over-box.fbx","name":"Vault Over Box","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/vault-over-box.fbx"}},"exposed":true,"binding":"animations.vaultBox","label":"Vault Box Variant Clip","category":"Animations","description":"Vault Box Variant — optional one-shot available to the random/condition vault selector."},{"name":"AnimWallFlip","type":"string","value":{"clip":"Wall Flip","asset":{"id":"wall-flip","key":"builtin:character/shared/wall-flip.fbx","src":"models/characters/shared/wall-flip.fbx","name":"Wall Flip","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/wall-flip.fbx"}},"exposed":true,"binding":"animations.wallFlip","label":"Wall Flip Clip","category":"Animations","description":"Wall Flip — one-shot. Played only when sprinting into a tall wall; the root remains fixed."},{"name":"AnimMantle","type":"string","value":{"clip":"Climbing Pull Up","asset":{"id":"climbing-pull-up","key":"builtin:character/shared/climbing-pull-up.fbx","src":"models/characters/shared/climbing-pull-up.fbx","name":"Climbing Pull Up","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/climbing-pull-up.fbx"}},"exposed":true,"binding":"animations.mantle","label":"Mantle Clip","category":"Animations","description":"Mantle — one-shot. Played when the character pulls up onto a ledge up to Mantle Max Height."},{"name":"AnimClimb","type":"string","value":{"clip":"Climbing Loop","asset":{"id":"climbing-loop-normal","key":"builtin:character/shared/climbing-loop-normal.fbx","src":"models/characters/shared/climbing-loop-normal.fbx","name":"Climbing Loop","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/climbing-loop-normal.fbx"}},"exposed":true,"binding":"animations.climb","label":"Climb Clip","category":"Animations","description":"Climb — looping. Played while the character is on a climbable surface or a ladder."},{"name":"AnimHang","type":"string","value":{"clip":"Hanging Idle","asset":{"id":"hanging-idle","key":"builtin:character/shared/hanging-idle.fbx","src":"models/characters/shared/hanging-idle.fbx","name":"Hanging Idle","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/hanging-idle.fbx"}},"exposed":true,"binding":"animations.hang","label":"Hang Clip","category":"Animations","description":"Hang — looping. Played while the character holds a ledge before mantling or dropping."},{"name":"AnimLandHeavy","type":"string","value":{"clip":"Hard Landing","asset":{"id":"hard-landing","key":"builtin:character/shared/hard-landing.fbx","src":"models/characters/shared/hard-landing.fbx","name":"Hard Landing","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/hard-landing.fbx"}},"exposed":true,"binding":"animations.landHeavy","label":"Land Hard Clip","category":"Animations","description":"Land Hard — one-shot. Reserved for a damaging fall survived by the Character; a lethal fall goes directly to death physics / ragdoll."},{"name":"AnimLandCrouch","type":"string","value":"","exposed":true,"binding":"animations.landCrouch","label":"Land Crouched Clip","category":"Animations","description":"Land Crouched — one-shot. Played when the character lands while already crouched."},{"name":"AnimAim","type":"string","value":{"clip":"Idle Aiming","asset":{"id":"aim-idle","key":"builtin:character/shared/aim-idle.fbx","src":"models/characters/shared/aim-idle.fbx","name":"Idle Aiming","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/aim-idle.fbx"}},"exposed":true,"binding":"animations.aimIdle","label":"Aim Clip","category":"Animations","description":"Aim — looping in-place pose held while the aim button is down. The two-bone weapon-pose layer still points the arms at the target on top of it."},{"name":"AnimAimRifle","type":"string","value":{"clip":"Rifle Aiming Idle","asset":{"id":"aim-rifle-idle","key":"builtin:character/shared/aim-rifle-idle.fbx","src":"models/characters/shared/aim-rifle-idle.fbx","name":"Rifle Aiming Idle","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/aim-rifle-idle.fbx"}},"exposed":true,"binding":"animations.aimRifleIdle","label":"Aim (two-handed) Clip","category":"Animations","description":"Aim (two-handed) — looping in-place pose for a rifle or any weapon held with both hands."},{"name":"AnimFire","type":"string","value":{"clip":"Firing Rifle","asset":{"id":"fire-rifle","key":"builtin:character/shared/fire-rifle.fbx","src":"models/characters/shared/fire-rifle.fbx","name":"Firing Rifle","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/fire-rifle.fbx"}},"exposed":true,"binding":"animations.fire","label":"Fire Clip","category":"Animations","description":"Fire — one-shot recoil, in-place. Played on the body every shot, so the character visibly fires in third person."},{"name":"AnimFireSingleIdle","type":"string","value":"","exposed":true,"binding":"animations.fireSingleIdle","label":"Single Shot (idle) Clip","category":"Animations","description":"Single Shot (idle) — one-shot upper-body recoil while standing. Falls back to Fire."},{"name":"AnimFireSingleWalk","type":"string","value":"","exposed":true,"binding":"animations.fireSingleWalk","label":"Single Shot (walk) Clip","category":"Animations","description":"Single Shot (walk) — one-shot recoil authored over a walking lower body. Falls back to Fire."},{"name":"AnimFireSingleRun","type":"string","value":"","exposed":true,"binding":"animations.fireSingleRun","label":"Single Shot (run) Clip","category":"Animations","description":"Single Shot (run) — one-shot recoil authored over a running lower body. Falls back to Fire."},{"name":"AnimFireAutoIdle","type":"string","value":"","exposed":true,"binding":"animations.fireAutoIdle","label":"Multi Shot (idle) Clip","category":"Animations","description":"Multi Shot (idle) — recoil cycle for automatic/burst fire while standing. Falls back to Fire."},{"name":"AnimFireAutoWalk","type":"string","value":"","exposed":true,"binding":"animations.fireAutoWalk","label":"Multi Shot (walk) Clip","category":"Animations","description":"Multi Shot (walk) — recoil cycle for automatic/burst fire while walking. Falls back to Fire."},{"name":"AnimFireAutoRun","type":"string","value":"","exposed":true,"binding":"animations.fireAutoRun","label":"Multi Shot (run) Clip","category":"Animations","description":"Multi Shot (run) — recoil cycle for automatic/burst fire while running. Falls back to Fire."},{"name":"AnimRunAiming","type":"string","value":{"clip":"Rifle Run","asset":{"id":"run-aiming","key":"builtin:character/shared/run-aiming.fbx","src":"models/characters/shared/run-aiming.fbx","name":"Rifle Run","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/run-aiming.fbx"}},"exposed":true,"binding":"animations.runAiming","label":"Run Aiming Clip","category":"Animations","description":"Run Aiming — looping. Forward run with the weapon up, for moving while aimed."},{"name":"AnimCrouchIdle","type":"string","value":{"clip":"Idle Crouching","asset":{"id":"crouch-idle","key":"builtin:character/shared/crouch-idle.fbx","src":"models/characters/shared/crouch-idle.fbx","name":"Idle Crouching","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/crouch-idle.fbx"}},"exposed":true,"binding":"animations.crouchIdle","label":"Crouch Idle Clip","category":"Animations","description":"Crouch Idle — looping in-place pose held while crouched and stationary."},{"name":"AnimCrouchAim","type":"string","value":{"clip":"Idle Crouching Aiming","asset":{"id":"crouch-aim-idle","key":"builtin:character/shared/crouch-aim-idle.fbx","src":"models/characters/shared/crouch-aim-idle.fbx","name":"Idle Crouching Aiming","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/crouch-aim-idle.fbx"}},"exposed":true,"binding":"animations.crouchAimIdle","label":"Crouch Aim Clip","category":"Animations","description":"Crouch Aim — looping in-place pose, crouched with the weapon up."},{"name":"AnimCoverEnter","type":"string","value":{"clip":"Stand To Cover High","asset":{"id":"stand-to-cover-high","key":"builtin:character/shared/stand-to-cover-high.fbx","src":"models/characters/shared/stand-to-cover-high.fbx","name":"Stand To Cover High","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/stand-to-cover-high.fbx"}},"exposed":true,"binding":"animations.coverHigh","label":"Take Cover Clip","category":"Animations","description":"Take Cover — one-shot transition from standing into the cover stance."},{"name":"AnimCoverEnterLow","type":"string","value":{"clip":"Enter Cover Low","asset":{"id":"cover-low-enter","key":"builtin:character/shared/cover-low-enter.fbx","src":"models/characters/shared/cover-low-enter.fbx","name":"Enter Cover Low","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/cover-low-enter.fbx"}},"exposed":true,"binding":"animations.coverLow","label":"Take Cover (low) Clip","category":"Animations","description":"Take Cover (low) — one-shot transition into a crouched cover stance. Preferred over the high entry when the cover is low."},{"name":"AnimCoverExit","type":"string","value":{"clip":"Cover To Stand","asset":{"id":"cover-to-stand-b","key":"builtin:character/shared/cover-to-stand-b.fbx","src":"models/characters/shared/cover-to-stand-b.fbx","name":"Cover To Stand","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/cover-to-stand-b.fbx"}},"exposed":true,"binding":"animations.coverToStand","label":"Leave Cover Clip","category":"Animations","description":"Leave Cover — one-shot transition from the cover stance back to standing."},{"name":"AnimCoverSneakLeft","type":"string","value":{"clip":"Cover Sneak Left","asset":{"id":"cover-sneak-left","key":"builtin:character/shared/cover-sneak-left.fbx","src":"models/characters/shared/cover-sneak-left.fbx","name":"Cover Sneak Left","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/cover-sneak-left.fbx"}},"exposed":true,"binding":"animations.coverSneakLeft","label":"Cover Shuffle Left Clip","category":"Animations","description":"Cover Shuffle Left — looping. Moving along cover to the character own left."},{"name":"AnimCoverSneakRight","type":"string","value":{"clip":"Cover Sneak Right","asset":{"id":"cover-sneak-right","key":"builtin:character/shared/cover-sneak-right.fbx","src":"models/characters/shared/cover-sneak-right.fbx","name":"Cover Sneak Right","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/cover-sneak-right.fbx"}},"exposed":true,"binding":"animations.coverSneakRight","label":"Cover Shuffle Right Clip","category":"Animations","description":"Cover Shuffle Right — looping. Moving along cover to the character own right."},{"name":"AnimDeathFront","type":"string","value":{"clip":"Death From The Front","asset":{"id":"death-front","key":"builtin:character/shared/death-front.fbx","src":"models/characters/shared/death-front.fbx","name":"Death From The Front","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/death-front.fbx"}},"exposed":true,"binding":"animations.deathFront","label":"Death (front) Clip","category":"Animations","description":"Death (front) — one-shot. Hit from the front; the body falls backward onto its back. For a scripted or low-end death in place of the ragdoll."},{"name":"AnimDeathBack","type":"string","value":{"clip":"Death From Behind","asset":{"id":"death-back","key":"builtin:character/shared/death-back.fbx","src":"models/characters/shared/death-back.fbx","name":"Death From Behind","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/death-back.fbx"}},"exposed":t