l":"Shoulder Swap Speed","category":"Third Person / Aim","min":0.5,"max":60,"step":0.5,"description":"How fast the camera crosses to the other shoulder. Low values read as a deliberate arc."},{"name":"TpsEyeHeight","type":"number","value":1.6704880390554857,"exposed":true,"binding":"firstPerson.eyeHeight","label":"Eye Height (m)","category":"Third Person / Aim","min":0.4,"max":2.6,"step":0.01},{"name":"TpsBodyEyeForward","type":"number","value":0.3835236226506702,"exposed":true,"binding":"firstPerson.bodyEyeForward","label":"Full-Body Eye Forward (m)","category":"Third Person / Aim","min":0.18,"max":0.6,"step":0.01,"description":"Camera-only clearance beyond the face, avoiding clipping and overdraw without changing the Character skeleton."},{"name":"TpsBodyEyeSide","type":"number","value":0,"exposed":true,"binding":"firstPerson.bodyEyeSide","label":"Full-Body Eye Side Offset (m)","category":"Third Person / Aim","min":-0.5,"max":0.5,"step":0.01},{"name":"TpsLeanOffset","type":"number","value":0.42,"exposed":true,"binding":"firstPerson.lean.offset","label":"Lean Reach (m)","category":"Third Person / Aim","min":0,"max":1.5,"step":0.02},{"name":"TpsLeanAngle","type":"number","value":0.26,"exposed":true,"binding":"firstPerson.lean.angle","label":"Lean Roll (rad)","category":"Third Person / Aim","min":0,"max":1.2,"step":0.02},{"name":"TpsShakeEnabled","type":"boolean","value":true,"exposed":true,"binding":"firstPerson.shake.enabled","label":"Camera Shake","category":"Third Person / Feel","description":"Shake moves the camera only. It never moves the bullet: recoil does that."},{"name":"TpsShakeFire","type":"number","value":0.16,"exposed":true,"binding":"firstPerson.shake.fire","label":"Shake — Firing","category":"Third Person / Feel","min":0,"max":1,"step":0.01},{"name":"TpsShakeLand","type":"number","value":0.34,"exposed":true,"binding":"firstPerson.shake.land","label":"Shake — Hard Landing","category":"Third Person / Feel","min":0,"max":1,"step":0.01},{"name":"TpsShakeDamage","type":"number","value":0.45,"exposed":true,"binding":"firstPerson.shake.damage","label":"Shake — Taking Damage","category":"Third Person / Feel","min":0,"max":1,"step":0.01},{"name":"TpsShakeDecay","type":"number","value":1.8,"exposed":true,"binding":"firstPerson.shake.decay","label":"Shake Decay","category":"Third Person / Feel","min":0.1,"max":10,"step":0.1},{"name":"TpsViewBob","type":"boolean","value":true,"exposed":true,"binding":"firstPerson.viewBob.enabled","label":"View Bob","category":"Third Person / Feel"},{"name":"TpsWeaponPreset","type":"string","value":"rifle","exposed":true,"binding":"firstPerson.weapon.preset","label":"Weapon Preset","category":"Combat / Weapon","ui":"select","options":[{"value":"rifle","label":"Assault Rifle (automatic)"},{"value":"marksman","label":"Marksman Rifle (semi-automatic)"},{"value":"shotgun","label":"Shotgun (spread pellets)"},{"value":"smg","label":"SMG"},{"value":"pistol","label":"Sidearm"}],"description":"Starting weapon profile. It seeds the values below; tune them afterwards for a custom weapon."},{"name":"TpsWeaponDamage","type":"number","value":22,"exposed":true,"binding":"firstPerson.weapon.damage","label":"Damage per Hit","category":"Combat / Weapon","min":0,"max":500,"step":1},{"name":"TpsHeadshotMultiplier","type":"number","value":2,"exposed":true,"binding":"firstPerson.weapon.headshotMultiplier","label":"Headshot Multiplier","category":"Combat / Weapon","min":1,"max":8,"step":0.1},{"name":"TpsFireRate","type":"number","value":9.5,"exposed":true,"binding":"firstPerson.weapon.fireRate","label":"Fire Rate (shots/s)","category":"Combat / Weapon","min":0.5,"max":30,"step":0.1},{"name":"TpsMagazineSize","type":"number","value":30,"exposed":true,"binding":"firstPerson.weapon.magazine","label":"Magazine Size","category":"Combat / Weapon","min":1,"max":200,"step":1},{"name":"TpsReserveAmmo","type":"number","value":180,"exposed":true,"binding":"firstPerson.weapon.ammoReserve","label":"Reserve Ammo","category":"Combat / Weapon","min":0,"max":5000,"step":10},{"name":"TpsReloadTime","type":"number","value":1.9,"exposed":true,"binding":"firstPerson.weapon.reloadTime","label":"Reload Time (s)","category":"Combat / Weapon","min":0.1,"max":8,"step":0.1},{"name":"TpsSpreadHip","type":"number","value":0.026,"exposed":true,"binding":"firstPerson.weapon.spreadHip","label":"Hip Spread","category":"Combat / Weapon","min":0,"max":0.3,"step":0.002},{"name":"TpsSpreadAds","type":"number","value":0.005,"exposed":true,"binding":"firstPerson.weapon.spreadAds","label":"Aim Spread","category":"Combat / Weapon","min":0,"max":0.3,"step":0.001},{"name":"TpsRecoilPitch","type":"number","value":0.018,"exposed":true,"binding":"firstPerson.weapon.recoilPitch","label":"Recoil Kick","category":"Combat / Weapon","min":0,"max":0.3,"step":0.002},{"name":"TpsRecoilRecovery","type":"number","value":8.5,"exposed":true,"binding":"firstPerson.weapon.recoilRecovery","label":"Recoil Recovery","category":"Combat / Weapon","min":0.5,"max":40,"step":0.5},{"name":"TpsWeaponRange","type":"number","value":140,"exposed":true,"binding":"firstPerson.weapon.range","label":"Range (m)","category":"Combat / Weapon","min":5,"max":1000,"step":5},{"name":"TpsGripHands","type":"string","value":"auto","exposed":true,"binding":"weaponGrip.hands","label":"Hands On The Weapon","category":"Combat / Weapon Grip","ui":"select","options":[{"value":"auto","label":"Automatic — follow the weapon"},{"value":"single","label":"One hand (sidearm)"},{"value":"double","label":"Both hands (shouldered)"},{"value":"thrown","label":"Thrown — cocked beside the head"},{"value":"unarmed","label":"Unarmed — guard and punch"}],"description":"Automatic keeps the built-in rule: a sidearm in one hand, fists and throwables in their own poses, everything else shouldered."},{"name":"TpsGripSupportHand","type":"string","value":"auto","exposed":true,"binding":"weaponGrip.supportHand","label":"Support Hand","category":"Combat / Weapon Grip","ui":"select","options":[{"value":"auto","label":"Automatic — per weapon kind"},{"value":"on","label":"Always on the weapon"},{"value":"off","label":"Free (leave the arm swinging)"}],"description":"Automatic puts the second hand on a shouldered weapon and on the unarmed guard, and leaves it free for a sidearm or a blade."},{"name":"TpsGripTrigger","type":"vector3","value":[0,0,0],"exposed":true,"binding":"weaponGrip.trigger","label":"Trigger Hand Offset (m)","category":"Combat / Weapon Grip","description":"Right / up / forward from the eye. Zero inherits the default for the weapon kind (a firearm carries at .15 / -.18 / .40)."},{"name":"TpsGripTriggerRotation","type":"vector3","value":[0,0,0],"exposed":true,"binding":"weaponGrip.triggerRotation","label":"Trigger Hand Rotation (deg)","category":"Combat / Weapon Grip","description":"Roll of the trigger hand around its own axes. Aiming a chain at a point leaves the twist free, so this is the only way to stop a hand holding a rifle sideways."},{"name":"TpsGripSupport","type":"vector3","value":[0,0,0],"exposed":true,"binding":"weaponGrip.support","label":"Support Hand Offset (m)","category":"Combat / Weapon Grip","description":"Zero lets the view model solve the hand onto the foregrip of the weapon it is really drawing, which is more accurate than any offset. Authoring a value takes that over."},{"name":"TpsGripSupportRotation","type":"vector3","value":[0,0,0],"exposed":true,"binding":"weaponGrip.supportRotation","label":"Support Hand Rotation (deg)","category":"Combat / Weapon Grip"},{"name":"TpsGripAimTrigger","type":"vector3","value":[0,0,0],"exposed":true,"binding":"weaponGrip.aimTrigger","label":"Aiming — Trigger Hand (m)","category":"Combat / Weapon Grip","description":"Added while the sights are up, eased in with them. Zero inherits: a firearm follows the weapon .05 back, .09 across and .04 up."},{"name":"TpsGripAimSupport","type":"vector3","value":[0,0,0],"exposed":true,"binding":"weaponGrip.aimSupport","label":"Aiming — Support Hand (m)","category":"Combat / Weapon Grip"},{"name":"TpsGripFireTrigger","type":"vector3","value":[0,0,0],"exposed":true,"binding":"weaponGrip.fireTrigger","label":"Firing — Trigger Hand (m)","category":"Combat / Weapon Grip","description":"Added for as long as the shot is on cooldown. Zero inherits: a firearm comes .08 back, a punch reaches .40 forward and a swing .38."},{"name":"TpsGripFireSupport","type":"vector3","value":[0,0,0],"exposed":true,"binding":"weaponGrip.fireSupport","label":"Firing — Support Hand (m)","category":"Combat / Weapon Grip"},{"name":"TpsRegen","type":"number","value":6,"exposed":true,"binding":"vitals.regen","label":"Health Regen (hp/s)","category":"Combat / Survival","min":0,"max":100,"step":0.5},{"name":"TpsRegenDelay","type":"number","value":6,"exposed":true,"binding":"vitals.regenDelay","label":"Regen Delay (s)","category":"Combat / Survival","min":0,"max":60,"step":0.5},{"name":"TpsCoverEnabled","type":"boolean","value":true,"exposed":true,"binding":"cover.enabled","label":"Cover System","category":"Cover","description":"Take cover against any solid wall. High cover (1.6 m and up) leans past the edge; low cover (0.85–1.45 m) is crouched behind and popped over."},{"name":"TpsCoverButton","type":"string","value":"crouch","exposed":true,"binding":"cover.button","label":"Take Cover Button","category":"Cover","ui":"select","options":[{"value":"crouch","label":"Crouch (contextual — only claimed facing cover)"},{"value":"takeCover","label":"Dedicated Take Cover action"},{"value":"dodge","label":"Dodge"},{"value":"slowWalk","label":"Slow Walk"},{"value":"interact","label":"Use"}]},{"name":"TpsCoverReach","type":"number","value":1.1,"exposed":true,"binding":"cover.reach","label":"Cover Reach (m)","category":"Cover","min":0.2,"max":4,"step":0.05},{"name":"TpsCoverHug","type":"number","value":0.42,"exposed":true,"binding":"cover.hugDistance","label":"Wall Hug Distance (m)","category":"Cover","min":0.05,"max":2,"step":0.02},{"name":"TpsCoverSlideSpeed","type":"number","value":0.78,"exposed":true,"binding":"cover.slideSpeed","label":"Move Along Cover","category":"Cover","min":0.05,"max":2,"step":0.02},{"name":"TpsCoverAutoAttach","type":"boolean","value":false,"exposed":true,"binding":"cover.autoAttach","label":"Auto Take Cover While Aiming","category":"Cover"},{"name":"TpsCoverAutoShoulder","type":"boolean","value":true,"exposed":true,"binding":"cover.autoShoulder","label":"Auto Shoulder At The Edge","category":"Cover"},{"name":"TpsCoverExposure","type":"number","value":1,"exposed":true,"binding":"cover.fire.exposure","label":"Lean-Out Exposure","category":"Cover","min":0,"max":1,"step":0.05},{"name":"TpsCoverBlindFire","type":"boolean","value":true,"exposed":true,"binding":"cover.fire.blindEnabled","label":"Blind Fire","category":"Cover"},{"name":"TpsCoverPopTime","type":"number","value":0.55,"exposed":true,"binding":"cover.fire.popTime","label":"Low Cover Pop Time (s)","category":"Cover","min":0.05,"max":4,"step":0.05},{"name":"TpsCrouchToggle","type":"boolean","value":true,"exposed":true,"binding":"abilities.crouch.toggle","label":"Crouch Is A Toggle","category":"Traversal"},{"name":"TpsCrouchSpeedScale","type":"number","value":0.88,"exposed":true,"binding":"abilities.crouch.speedScale","label":"Crouch Speed Scale","category":"Traversal","min":0.05,"max":1,"step":0.01},{"name":"TpsSlideMinSpeed","type":"number","value":4.2,"exposed":true,"binding":"abilities.slide.minSpeed","label":"Slide Minimum Speed","category":"Traversal","min":0.5,"max":20,"step":0.1,"description":"Double-tap Dodge above this speed slides; below it, the same gesture rolls."},{"name":"TpsSlideDuration","type":"number","value":0.85,"exposed":true,"binding":"abilities.slide.duration","label":"Slide Duration (s)","category":"Traversal","min":0.1,"max":4,"step":0.05},{"name":"TpsRollDistance","type":"number","value":2.85,"exposed":true,"binding":"abilities.slide.rollDistance","label":"Roll Travel (m)","category":"Traversal","min":0.1,"max":12,"step":0.05,"description":"Total forward distance while the authored roll clip plays. Duration is synchronized to the clip."},{"name":"TpsRollPlaybackRate","type":"number","value":1,"exposed":true,"binding":"abilities.slide.rollPlaybackRate","label":"Roll Animation Speed","category":"Traversal","min":0.25,"max":3,"step":0.05,"description":"Playback multiplier for the roll clip. Movement duration follows it automatically while Roll Travel remains the authored distance."},{"name":"TpsVaultMaxHeight","type":"number","value":1.25,"exposed":true,"binding":"abilities.vault.maxHeight","label":"Vault Max Height (m)","category":"Traversal","min":0.2,"max":4,"step":0.05},{"name":"TpsVaultSelection","type":"string","value":"primary","exposed":true,"binding":"abilities.vault.selectionMode","label":"Vault Animation Selection","category":"Traversal","ui":"select","options":[{"value":"primary","label":"Primary only (Front Flip)"},{"value":"random","label":"Random enabled variant"},{"value":"conditions","label":"Obstacle height / depth rules"}]},{"name":"TpsVaultDefaultSlot","type":"string","value":"vault","exposed":true,"binding":"abilities.vault.defaultSlot","label":"Default Vault Slot","category":"Traversal","ui":"select","options":[{"value":"vault","label":"Front Flip Vault"},{"value":"vaultBox","label":"Vault Over Box"}]},{"name":"TpsWallFlipEnabled","type":"boolean","value":true,"exposed":true,"binding":"abilities.wallFlip.enabled","label":"Running Wall Flip","category":"Traversal"},{"name":"TpsWallFlipMinSpeed","type":"number","value":4.2,"exposed":true,"binding":"abilities.wallFlip.minSpeed","label":"Wall Flip Minimum Speed","category":"Traversal","min":0.5,"max":20,"step":0.1},{"name":"TpsWallFlipMinHeight","type":"number","value":1.35,"exposed":true,"binding":"abilities.wallFlip.minHeight","label":"Wall Flip Minimum Wall Height","category":"Traversal","min":0.5,"max":6,"step":0.05},{"name":"TpsMantleMaxHeight","type":"number","value":2.35,"exposed":true,"binding":"abilities.mantle.maxHeight","label":"Mantle Max Height (m)","category":"Traversal","min":0.3,"max":6,"step":0.05},{"name":"TpsClimbSpeed","type":"number","value":2.4,"exposed":true,"binding":"abilities.climb.speed","label":"Climb Speed (m/s)","category":"Traversal","min":0.2,"max":10,"step":0.1},{"name":"TpsLandRollSpeed","type":"number","value":9,"exposed":true,"binding":"abilities.land.rollSpeed","label":"Landing Roll Threshold (m/s)","category":"Traversal","min":1,"max":60,"step":0.5,"description":"Impact speed above which a landing rolls out instead of planting the feet."},{"name":"TpsFallDamageSpeed","type":"number","value":10,"exposed":true,"binding":"abilities.land.damageSpeed","label":"Fall Damage Threshold (m/s)","category":"Traversal","min":1,"max":60,"step":0.5,"description":"Impact speed above which a non-rolled fall damages the Character and may use Hard Landing if survived."},{"name":"TpsFallDamageScale","type":"number","value":8,"exposed":true,"binding":"abilities.land.damageScale","label":"Fall Damage per Excess m/s","category":"Traversal","min":0,"max":100,"step":0.5,"description":"Health damage for every m/s above the threshold. A lethal impact goes directly to ragdoll."},{"name":"TpsLandRecovery","type":"number","value":0.32,"exposed":true,"binding":"abilities.land.recovery","label":"Hard Landing Recovery (s)","category":"Traversal","min":0,"max":2,"step":0.02},{"name":"AutoEyeHeight","type":"boolean","value":false,"exposed":true,"binding":"firstPerson.autoEyeHeight","label":"Use Main Mesh Head Height","category":"First Person / View","description":"Places the camera from the real Head bone of the Character. Disable it to use Eye Height manually."},{"name":"EyeBoneOffset","type":"number","value":0.08,"min":-0.3,"max":0.5,"step":0.01,"exposed":true,"binding":"firstPerson.eyeBoneOffset","label":"Head Bone → Eyes Offset (m)","category":"First Person / View","description":"Vertical distance from the rig Head bone pivot to the eyes."}],"nodes":[{"id":"on_start","type":"event.onStart","x":80,"y":100,"data":{}},{"id":"get_self","type":"pawn.getSelf","x":330,"y":25,"data":{}},{"id":"get_player","type":"variable.get","x":330,"y":145,"data":{"name":"ControllerPlayerId"}},{"id":"possess","type":"pawn.possess","x":590,"y":100,"data":{"force":false}},{"id":"get_camera","type":"variable.get","x":580,"y":230,"data":{"name":"CameraMode"}},{"id":"camera","type":"pawn.setCamera","x":850,"y":100,"data":{"possess":true}},{"id":"ready","type":"debug.print","x":1405,"y":118,"data":{"message":"Normal Character Pawn ready. WASD move, Shift sprint, Space jump, F interact.","duration":4}},{"id":"on_update","type":"event.onUpdate","x":80,"y":410,"data":{}},{"id":"move_input","type":"character.getMoveInput","x":340,"y":390,"data":{}},{"id":"set_move","type":"character.setMoveInput","x":650,"y":410,"data":{}}],"edges":[{"id":"e_start","from":{"node":"on_start","pin":"then"},"to":{"node":"possess","pin":"exec"}},{"id":"e_self","from":{"node":"get_self","pin":"pawn"},"to":{"node":"possess","pin":"pawn"}},{"id":"e_player","from":{"node":"get_player","pin":"value"},"to":{"node":"possess","pin":"playerId"}},{"id":"e_possess_camera","from":{"node":"possess","pin":"completed"},"to":{"node":"camera","pin":"exec"}},{"id":"e_self_camera","from":{"node":"get_self","pin":"pawn"},"to":{"node":"camera","pin":"pawn"}},{"id":"e_mode","from":{"node":"get_camera","pin":"value"},"to":{"node":"camera","pin":"mode"}},{"id":"e_update","from":{"node":"on_update","pin":"then"},"to":{"node":"set_move","pin":"exec"}},{"id":"e_x","from":{"node":"move_input","pin":"x"},"to":{"node":"set_move","pin":"x"}},{"id":"e_z","from":{"node":"move_input","pin":"z"},"to":{"node":"set_move","pin":"z"}},{"id":"e_sprint","from":{"node":"move_input","pin":"sprint"},"to":{"node":"set_move","pin":"sprint"}}],"comments":[{"id":"movement_help","title":"Generic Character base. Camera-relative input drives movement; the animation graph only supplies in-place poses. Movement, collision and ju