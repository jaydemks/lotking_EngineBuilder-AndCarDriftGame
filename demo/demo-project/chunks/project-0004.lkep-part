uiltin:character/shared/climbing-to-top.fbx","src":"models/characters/shared/climbing-to-top.fbx","name":"Climbing To Top","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/climbing-to-top.fbx"}},"exposed":true,"binding":"animations.climbUp","label":"Climb Up Clip","category":"Animations","description":"Climb Up — looping. Played while the character is moving upward on a climbable surface or a ladder."},{"name":"AnimClimbDown","type":"string","value":{"clip":"Climbing To Top (Reverse)","asset":{"id":"climbing-to-top","key":"builtin:character/shared/climbing-to-top.fbx","src":"models/characters/shared/climbing-to-top.fbx","name":"Climbing To Top (Reverse)","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/climbing-to-top.fbx","playbackRate":-1}},"exposed":true,"binding":"animations.climbDown","label":"Climb Down Clip","category":"Animations","description":"Climb Down — looping. The bundled default plays Climbing To Top in reverse; an author can replace it independently."},{"name":"AnimLedgeShimmyLeft","type":"string","value":{"clip":"Ledge Shimmy Left","asset":{"id":"ledge-shimmy-left","key":"builtin:character/shared/ledge-shimmy-left.fbx","src":"models/characters/shared/ledge-shimmy-left.fbx","name":"Ledge Shimmy Left","source":"Bundled character motion","kind":"fbx","sourceFormat":"fbx","sourceSrc":"models/characters/shared/ledge-shimmy-left.fbx"}},"exposed":true,"binding":"animations.ledgeShimmyLeft","label":"Ledge Shimmy Left Clip","category":"Animations","description":"Ledge Shimmy Left — looping. Played while the character moves left along a ledge it is hanging from."},{"name":"AnimLedgeShimmyRight","type":"string","value":{"clip":"Ledge Shimmy Right","asset":{"id":"ledge-shimmy-right","key":"builtin:character/shared/ledge-shimmy-right.fbx","src":"models/characters/shared/ledge-shimmy-right.fbx","name":"Ledge Shimmy Right","source":"Bundled charac